meta {
  name: Authorize
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ditto/authorize
  body: json
  auth: none
}

body:json {
  {
    "appID": "{{dittoAppId}}",
    "provider": "{{dittoProvider}}",
    "token": "{\"accessToken\": \"{{accessToken}}\",\"transactionId\":null}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
